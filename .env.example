# 複製成 .env 後填入。.env 已列入 .gitignore，請勿提交。
# 未填寫的能力會以「示範模式」運作。

# Azure OpenAI 資源（對話、視覺、embedding）
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21

# 部署名稱（在 Azure AI Foundry 建立部署時取的名字）
AZURE_OPENAI_CHAT_DEPLOYMENT=        # 建議 gpt-5.6-luna（便宜、支援圖片輸入）；備選 gpt-5.4-nano
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=   # 建議 text-embedding-3-small
AZURE_OPENAI_VISION_DEPLOYMENT=      # 選填：圖片辨識改用較強的模型（例如 gpt-5.4-mini）；留空則用對話模型

# 語音轉文字（學習庫語音筆記），二擇一
# 方式一（建議）：Azure Speech + MAI-Transcribe-2，不需另外部署，沿用上面的端點與金鑰
AZURE_SPEECH_MODEL=MAI-Transcribe-2
# 方式二：Azure OpenAI 語音模型部署（專案有提供 gpt-4o-mini-transcribe 時）
AZURE_OPENAI_TRANSCRIBE_DEPLOYMENT=
AZURE_OPENAI_TRANSCRIBE_API_VERSION=2025-03-01-preview

# 圖片生成（衛教圖）。若與上面同一個資源，端點與金鑰可留空
AZURE_OPENAI_IMAGE_DEPLOYMENT=       # 例：MAI-Image-2.6 或 MAI-Image-2.6-Flash（名稱以 MAI- 開頭會自動改用 MAI 圖片 API）；也支援 gpt-image 系列
AZURE_OPENAI_IMAGE_ENDPOINT=
AZURE_OPENAI_IMAGE_API_KEY=
AZURE_OPENAI_IMAGE_API_VERSION=2025-04-01-preview
AZURE_OPENAI_IMAGE_QUALITY=low       # 只對 gpt-image 系列有效（low／medium／high）；MAI-Image 不使用此設定
