# 複製成 .env 後填入。金鑰只放在 .env（本機）與 Vercel 的 Environment Variables，不要 commit 或貼到對話。
# 沒有填 DATABASE_URL／SUPABASE_*：改用本機 SQLite 與 data/uploads（開發用）
# 沒有填 GEMINI_API_KEY：AI 功能以示範模式運作

# ---- 資料庫與檔案：Supabase ----
# Project Settings → Data API 的 Project URL
SUPABASE_URL=https://<project-ref>.supabase.co
# Project Settings → API Keys 的 Secret key（sb_secret_ 開頭，只放伺服器端）
SUPABASE_SECRET_KEY=
# 專案頁上方 Connect → Direct → Method 選 Transaction pooler（埠號 6543），把 [YOUR-PASSWORD] 換成資料庫密碼
DATABASE_URL=

# ---- AI：Gemini（Google AI Studio → Get API key）----
GEMINI_API_KEY=
# 選填：預設 gemini-3.6-flash；過載時自動改用 gemini-3.5-flash-lite、gemini-3.8-flash
GEMINI_CHAT_MODEL=
# 衛教插圖（Nano Banana 2）：GCP Agent Platform express mode 金鑰（https://console.cloud.google.com/expressmode）
# 有填就開啟插圖；沒填時衛教單卡片顯示圖示（AI Studio 免費方案沒有生圖額度）
VERTEX_API_KEY=

# ---- 網站共用密碼（選填）：有填時進入網站需要輸入密碼 ----
APP_PASSWORD=
